# Settings for the XML proofreader. Copy this file to .env and fill it in:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Never commit .env (it is in .gitignore). Variables already set in your shell win over .env.
# A setting left empty uses its default.

# --- API keys: fill in the one for the provider you use ---
# --provider openai (the default)
OPENAI_API_KEY=
# --provider anthropic
ANTHROPIC_API_KEY=

# --- Models (the values below are the defaults; the --model flag overrides them) ---
OPENAI_MODEL=gpt-6.1-terra
# How much a reasoning OpenAI model (gpt-5, gpt-6, o-series) thinks: none, low, medium, high, xhigh, max.
# Not used by older models such as gpt-4.1, which run with temperature 0 instead.
OPENAI_REASONING_EFFORT=low
ANTHROPIC_MODEL=claude-opus-5-5
# Most tokens Claude may use per paragraph: its thinking plus the JSON answer (whole number, at least 1)
ANTHROPIC_MAX_TOKENS=16000

# --- Optional LLM settings (the values below are the defaults) ---
# Tries per paragraph when the AI's answer can't be parsed (whole number, at least 1)
LLM_MAX_ATTEMPTS=3
# Requests sent at the same time (whole number, at least 1)
LLM_WORKERS=8
# When the provider says "too many requests": how many times to wait and try again (0 = never)
LLM_RATE_LIMIT_RETRIES=3
# First wait in seconds when the provider doesn't say how long; it doubles each time (10, 20, 40), max 120
LLM_RATE_LIMIT_WAIT=10
